# =====================================================
# UZ-Potash Korporativ Pochta Telegram Bot Sozlamalari
# Namuna fayl (.env.example) - GitHub uchun xavfsiz
# =====================================================

# 1. Telegram Bot Token (@BotFather dan olingan token)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Pochta Tizimi & Domen
MAIL_SERVER=127.0.0.1
MAIL_DOMAIN=uz-potash.uz

# 3. PostgreSQL (iRedMail vmail bazasi)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vmail
DB_USER=vmailadmin
DB_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
